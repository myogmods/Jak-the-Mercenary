                                                                        "kg378a"
                                                                        )
                                                                      )
                       )
    (dotimes (gp-1 (length *merc-markb-transport-info*))
      (set! (-> *merc-markb-transport-info* gp-1 spawned) #f)
      )
    (set! *merc-kill-count* 0) ;; Counts guard deaths as kills 
    (set! *merc-points* 0)     ;; Points meter for the task gets set to 0 at start 
    (set! *merc-prev-score* 0) ;; Variable to count previous score to play sound, setting to 0 here
    (set! *merc-combo-level* 1)
    (set! *merc-combo-meter* 0.0)
    (set! *merc-tracking-active* #t)
    (set! (-> self data-int32 0) 0)  ;; mission transport dead completion flag
    (set! (-> self data-int32 1) 0)  ;; blocking plane spawned flag
    (set! (-> self data-int32 2) 0)  ;; first-frame init flag
    (set! (-> self data-int32 3) 0)  ;; kill count
    (set! (-> self data-int32 4) 0)  ;; prev dead guards
    (set! (-> self data-int32 6) 0)  ;; keep spawn transports flag
    (set! (-> *game-info* score) 0.0)
    (set! (-> *game-info* goal) (-> (get-game-score-ref *game-info* (the-as int (game-score merc-markb))) 0))
    (dotimes (i 3) ;; Reset combo meter parameters
      (set! (-> *merc-last-weapons* i) #f)
      )
    (dotimes (i 14)
      (set! (-> *merc-weapon-hit-counts* i) 0)
      (set! (-> *merc-weapon-hit-times* i) 0)
      )
    (set! *merc-last-weapon-idx* 0)
    (set! (-> self start-time) (-> *display* game-clock frame-counter))
    (set! (-> self time-limit) (seconds 120))
    (set! (-> self slave 27)
          (ppointer->handle (process-spawn hud-timer :init hud-init-by-other :to self)))
    (set! (-> self slave 28)
          (ppointer->handle (process-spawn hud-score :init hud-init-by-other :to self)))
    (set! (-> self slave 31)
          (ppointer->handle (process-spawn hud-goal :init hud-init-by-other :to self)))
    ;; Draw combo multiplier text and meter
    (set! *merc-combo-proc*
      (ppointer->handle
        (process-spawn-function process
      (lambda :behavior process ()
        (set! (-> self mask) (process-mask menu))
        (set! (-> self clock) (-> *display* real-clock))
        (loop
          (when (not *progress-process*)
            (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf))
                                        (bucket-id debug-no-zbuf1))
              (dma-buffer-add-gs-set-flusha buf
                (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
              (let* ((combo-level *merc-combo-level*)
                    (font-col (cond
                                ((= combo-level 1) (font-color white))
                                ((= combo-level 2) (font-color blue))
                                ((= combo-level 3) (font-color cyan))
                                ((= combo-level 4) (font-color green))
                                ((= combo-level 5) (font-color yellow))
                                ((= combo-level 6) (font-color orange))
                                (else              (font-color red))
                                )
                              )
                    (bar-col (cond
                                ((= combo-level 1) (new 'static 'rgba :r 255 :g 255 :b 255 :a 128)) ;; white
                                ((= combo-level 2) (new 'static 'rgba :r 60  :g 120 :b 255 :a 128)) ;; blue
                                ((= combo-level 3) (new 'static 'rgba :r 0   :g 255 :b 255 :a 128)) ;; cyan
                                ((= combo-level 4) (new 'static 'rgba :r 0   :g 255 :b 0   :a 128)) ;; green
                                ((= combo-level 5) (new 'static 'rgba :r 255 :g 255 :b 0   :a 128)) ;; yellow
                                ((= combo-level 6) (new 'static 'rgba :r 255 :g 165 :b 0   :a 128)) ;; orange
                                (else              (new 'static 'rgba :r 255 :g 0   :b 0   :a 128)) ;; red
                                )
                              )
                    )
                ;; Use font-col for text
                (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 387 178 0.0 font-col (font-flags shadow kerning large))))
                  (set! (-> font-ctx scale) 0.25)
                  (pc-encode-utf8-string (string-format "x~D Combo" *merc-combo-level*) *pc-encoded-temp-string*)
                  (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
                  )
                (let* ((score-proc (process-by-name "hud-score" *active-pool*))
                      (score-hud  (the-as hud-score score-proc))
                      )
                  (when score-hud
                    (let* ((sprite-x  (-> score-hud sprites 0 pos x))
                          (sprite-y  (-> score-hud sprites 0 pos y))
                          (scale    (/ 0.1 (-> *pc-settings* width) ))  ;; try adjusting this
                          (bar-x     (the int (+ (* (the float sprite-x) scale) 387)))
                          (bar-y     (the int (+ (* (the float sprite-y) scale) 172)))
                          (level-min (* (- *merc-combo-level* 1) 5.0))
                          (progress  (fmin 1.0 (/ (- *merc-combo-meter* level-min) 5.0)))
                          (fill-w    (max 0 (min 90 (the int (* 90.0 progress)))))
                          )
                      (draw-sprite2d-xy buf bar-x bar-y 90 4 *color-gray*)
                      ;; Use bar-col for sprite
                      (draw-sprite2d-xy buf bar-x bar-y fill-w 4 bar-col)
                      )
                    )
                  )
                )
              )
            )
          (suspend)
          )
            )
      :to *entity-pool*
      :name "merc-combo-meter"
      )
    )
  )
    ;; Set up stats to be consistent each time 
      (set! (-> *game-info* eco-pill-dark) 0.0)
      (set! (-> *game-info* gun-ammo 0) (-> *FACT-bank* ammo-yellow-start))
      (set! (-> *game-info* gun-ammo 1) (-> *FACT-bank* ammo-red-start))
      (set! (-> *game-info* gun-ammo 2) (-> *FACT-bank* ammo-blue-start))
      (set! (-> *game-info* gun-ammo 3) (-> *FACT-bank* ammo-dark-start))
    ;; Start gradual transition toward heavy rain
    (set! (-> *mood-control* overide-weather-flag) #f)
    (set! (-> *mood-control* target-interp cloud) 1.0)
    (set! (-> *mood-control* target-interp fog) 1.0)
    ;; Speed of 45.0, takes 45 seconds to reach full rain
    (set! (-> *mood-control* speed-interp cloud) 45.0)
    (set! (-> *mood-control* speed-interp fog) 45.0)
    ;; Prevent random weather from interrupting the transition
    (set-time-for-random-weather! *mood-control* 99999.0 99999.0)
    ;; --- Set up blocking plane for onintent  ---
    (when (zero? (-> self data-int32 1))
      (let ((wall-pts (new 'stack-no-clear 'inline-array 'vector 2)))
        (set-vector! (-> wall-pts 0) (meters 710.16) (meters  8.44) (meters 750.31) 1.0)
        (set-vector! (-> wall-pts 1) (meters 714.86) (meters  8.44) (meters 750.17) 1.0)
        (set! (-> self slave 54) 
              (ppointer->handle (process-spawn blocking-plane wall-pts (meters 8) :name "blocking-plane-markb-mercenary")))
        )
      (set! (-> self data-int32 1) 1)
      )
    ;; Set up security walls
    (set! (-> self slave 30)
      (ppointer->handle
        (process-spawn security-wall
          (new 'static 'vector :x (meters 399.50) :y (meters  9.50) :z (meters 740.80) :w 1.0)
