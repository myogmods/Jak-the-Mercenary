    (set! (-> self slave 45)
      (ppointer->handle
        (process-spawn security-wall
          (new 'static 'vector :x (meters 399.50) :y (meters  15.00) :z (meters 706.55) :w 1.0)
          (new 'static 'vector :x (meters 420.67) :y (meters  20.56) :z (meters 706.45) :w 1.0)
          (meters 16)
          :init security-wall-init-by-other
          :name "security-wall-markb-mercenary-9"
          )
