          (new 'static 'vector :x (meters 420.67) :y (meters  20.56) :z (meters 684.80) :w 1.0)
          (new 'static 'vector :x (meters 399.50) :y (meters  15.00) :z (meters 684.80) :w 1.0)
          (meters 16)
          :init security-wall-init-by-other
