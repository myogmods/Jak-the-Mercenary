    (set! (-> self slave 33)
      (ppointer->handle
        (process-spawn security-wall
          (new 'static 'vector :x (meters 518.81) :y (meters  20.56) :z (meters 597.20) :w 1.0)
          (new 'static 'vector :x (meters 646.56) :y (meters  20.56) :z (meters 597.20) :w 1.0)
          (meters 15)
