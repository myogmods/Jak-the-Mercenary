    (set! (-> self slave 47)
      (ppointer->handle
        (process-spawn security-wall
          (new 'static 'vector :x (meters 420.67) :y (meters  20.56) :z (meters 706.45) :w 1.0)
          (new 'static 'vector :x (meters 539.30) :y (meters  20.56) :z (meters 706.45) :w 1.0)
          (meters 15)
          :init security-wall-init-by-other
          :name "security-wall-markb-mercenary-10"
