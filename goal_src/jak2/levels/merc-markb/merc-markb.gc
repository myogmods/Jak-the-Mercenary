    (set! (-> self slave 50)
      (ppointer->handle
        (process-spawn security-wall
          (new 'static 'vector :x (meters 538.80) :y (meters  20.56) :z (meters 618.35) :w 1.0)
          (new 'static 'vector :x (meters 668.01) :y (meters  20.56) :z (meters 618.35) :w 1.0)
          (meters 15)
          :init security-wall-init-by-other
          :name "security-wall-markb-mercenary-12"
          )
        )
      )
    (set! (-> self slave 51)
      (ppointer->handle
        (process-spawn security-wall
          (new 'static 'vector :x (meters 667.51) :y (meters  20.56) :z (meters 618.35) :w 1.0)
          (new 'static 'vector :x (meters 667.51) :y (meters  20.56) :z (meters 558.58) :w 1.0)
          (meters 15)
          :init security-wall-init-by-other
          :name "security-wall-markb-mercenary-13"
          )
        )
      )
    (set! (-> self slave 52)
      (ppointer->handle
        (process-spawn security-wall
          (new 'static 'vector :x (meters 727.82) :y (meters  1.56) :z (meters 441.74) :w 1.0)
          (new 'static 'vector :x (meters 683.52) :y (meters  26.56) :z (meters 441.74) :w 1.0)
          (meters 15)
          :init security-wall-init-by-other
          :name "security-wall-markb-mercenary-14"
          )
        )
      )
    (set! (-> self slave 53)
      (ppointer->handle
        (process-spawn security-wall
          (new 'static 'vector :x (meters 729.92) :y (meters  8.30) :z (meters 441.74) :w 1.0)
          (new 'static 'vector :x (meters 729.92) :y (meters  8.30) :z (meters 420.15) :w 1.0)
          (meters 15)
          :init security-wall-init-by-other
          :name "security-wall-markb-mercenary-15"
          )
        )
      )
    ;; Reset result screen flag  
    (set! (-> self data-int32 5) 0)
    ;; Mark timer as initialized
    (set! (-> self data-int32 2) 1)
    (none)
    )
  )

;; Variable to count previous score to play sound 
(define *merc-prev-score* 0)

(set-subtask-hook!
  *game-info*
  (game-task-node city-burning-bush-markb-mercenary-resolution)
  TASK_MANAGER_UPDATE_HOOK
  (lambda :behavior task-manager
    ()
    ;; give everything except gun-upgrade-damage
    (logior! (-> *game-info* features) (game-feature 
      gun gun-yellow gun-red gun-blue gun-dark 
      board
      gun-upgrade-speed gun-upgrade-ammo 
      pass-red pass-green pass-yellow pass-blue 
      darkjak darkjak-bomb0 darkjak-bomb1 darkjak-invinc darkjak-giant
      ))
    (logclear! (-> *game-info* features) (game-feature gun-upgrade-damage pass-red pass-green pass-yellow))
    ;; Remove all cheats player could be using
    (logclear! (-> *game-info* secrets) (game-secrets invulnerable))
    (logclear! (-> *game-info* secrets) (game-secrets endless-dark))
    (logclear! (-> *game-info* secrets) (game-secrets endless-ammo))
    (local-vars (s5-4 object))
    ;; Once weather has fully transitioned to heavy rain, lock it with override
    (when (and (not (-> *mood-control* overide-weather-flag))
              (>= (-> *mood-control* current-interp cloud) 0.99)
              (>= (-> *mood-control* current-interp fog) 0.99)
              )
      (set! (-> *mood-control* overide-weather-flag) #t)
      (set! (-> *mood-control* overide cloud) 1.0)
      (set! (-> *mood-control* overide fog) 1.0)
      )
    ;; TIMER UPDATE (update timer every frame)
    (when (nonzero? (-> self data-int32 2))
      (let ((remaining (the-as int (- (-> self time-limit)
                                      (- (-> *display* game-clock frame-counter)
                                        (-> self start-time)
                                        )
                                      )
                      )
            )
            )
        (if (< (the-as time-frame remaining) 0)
            (set! remaining 0)
            )
        (set! (-> *game-info* timer) (the-as time-frame remaining))
        (when (zero? remaining)
          (send-event (handle->process (-> self slave 27)) 'hide-and-die)
          (send-event (handle->process (-> self slave 28)) 'hide-and-die)
          (set! (-> self data-int32 5) 1) ;; Set flag to run (merc-show-results)
          ;; (go-virtual fail)
          )
        )
      )
    ;; Decay speed based on current level
    (let ((decay-rate (cond
                        ((>= *merc-combo-meter* 30.0) 2.00)  ;; lv7 
                        ((>= *merc-combo-meter* 25.0) 1.75)  ;; lv6
                        ((>= *merc-combo-meter* 20.0) 1.50)  ;; lv5
                        ((>= *merc-combo-meter* 15.0) 1.25)  ;; lv4
                        ((>= *merc-combo-meter* 10.0) 1.00)  ;; lv3
                        ((>= *merc-combo-meter* 5.0)  0.75)  ;; lv2
                        (else                         0.50)  ;; lv1
                        )
                      )
          )
      ;; Decay combo meter
      (set! *merc-combo-meter* (fmax 0.0 (- *merc-combo-meter* (* (seconds-per-frame) decay-rate))))
      )
    ;; Cap meter at max level 7 full bar
    (set! *merc-combo-meter* (fmin 35.0 *merc-combo-meter*))
    ;; Level derived directly from meter value
    (set! *merc-combo-level* (cond
      ((>= *merc-combo-meter* 30.0) 7)
      ((>= *merc-combo-meter* 25.0) 6)
      ((>= *merc-combo-meter* 20.0) 5)
      ((>= *merc-combo-meter* 15.0) 4)
      ((>= *merc-combo-meter* 10.0) 3)
      ((>= *merc-combo-meter* 5.0)  2)
      (else                         1)
      ))
    ;; ;; Points = kills * 250 * combo level
    ;; (set! *merc-points* (* *merc-kill-count* 250 *merc-combo-level*))
    (set! (-> *game-info* score) (the float *merc-points*))
    ;; Fill based on progress toward next level threshold
    (the int (* 90.0 (/ (- *merc-combo-meter* (* (- *merc-combo-level* 1) 5.0)) 5.0)))
    
    ;; Play sound effect when kill count increases
    (when (> *merc-kill-count* *merc-prev-score*)
      (play-sound-file "get-point.wav" (the int (* (-> *setting-control* user-current sfx-volume) 30.0)))
      (set! *merc-prev-score* *merc-kill-count*)
      )
    ;; Update hud-goal with highscore
    (let ((hi-ref (get-game-score-ref *game-info* (the-as int (game-score merc-markb)))))
      (if (>= (-> *game-info* score) (-> hi-ref 0))
          (set! (-> *game-info* goal) (-> *game-info* score))
          (set! (-> *game-info* goal) (-> hi-ref 0))
          )
      )
    ;; Only run transport spawning/completion when not in results screen
    (when (zero? (-> self data-int32 6))
      ;; Vanilla code to spawn transports etc
      (cond
        ((zero? (-> self data-int32 0))
         (dotimes (gp-1 (length *merc-markb-transport-info*))
           (let ((s5-1 (-> *merc-markb-transport-info* gp-1)))
             (new 'stack-no-clear 'vector)
             (new 'stack-no-clear 'vector)
             (new 'stack-no-clear 'vector)
             (new 'stack-no-clear 'vector)
             0.0
             (let ((f0-7 (vector-vector-xz-distance (target-pos 0) (-> s5-1 t-pos))))
               (cond
                 ((and (< f0-7 (meters 90)) (< (meters 50) f0-7)) ;; Converted to meters and increased max distance from 80 to 90 to spawn transports
                  (when (and (not (handle->process (-> self slave gp-1))) (< (the int (-> self data-float gp-1)) (current-time)))
                    (let ((s4-2 (new 'stack-no-clear 'transport-params)))
                      (let ((s3-2 (new 'stack-no-clear 'vector)))
                        (set! (-> s3-2 quad) (-> s5-1 t-pos quad))
                        (set! (-> s4-2 spawn-pos quad) (-> s5-1 t-pos quad))
                        (quaternion-copy! (-> s4-2 quat) (-> s5-1 t-quat))
                        (set! (-> s4-2 max-guard) (-> s5-1 num-guard))
                        (set! (-> s4-2 max-guard) (the-as uint 8))
                        (set! (-> s4-2 turret?) #t)
                        (set! (-> s4-2 speeches?) #t)
                        (set! (-> s3-2 y) 0.0)
                        )
                      (let ((a0-16 (as-type (entity-nav-mesh-by-aid (the-as actor-id 22083)) entity-nav-mesh)))
                        (when a0-16
                          (set! (-> s4-2 nav-mesh) (-> a0-16 nav-mesh))
                          (set! (-> self slave gp-1) (ppointer->handle (process-spawn transport s4-2 :to self)))
                          )
                        )
                      )
                    )
                  )
                 ((< 368640.0 f0-7)
                  (if (handle->process (-> self slave gp-1))
                      (send-event (handle->process (-> self slave gp-1)) 'leave)
                      )
                  )
                 )
               )
             )
           (if (and (handle->process (-> self slave gp-1))
                    (begin
                      (let ((s5-5 #t)
                            (a1-11 (new 'stack-no-clear 'event-message-block))
                            )
                        (set! (-> a1-11 from) (process->ppointer self))
                        (set! (-> a1-11 num-params) 0)
                        (set! (-> a1-11 message) 'guards-left)
                        (let ((v1-75 (the-as object (send-event-function (handle->process (-> self slave gp-1)) a1-11))))
                          (cmove-#f-nonzero s5-4 v1-75 s5-5)
                          )
                        )
                      s5-4
                      )
                    )
               (set! (-> self data-float gp-1) (the float (+ (current-time) (seconds 20))))
               )
           )
         )
        (else
          (let ((gp-2 0))
            (dotimes (s5-6 (length *merc-markb-transport-info*))
              (when (handle->process (-> self slave s5-6))
                (send-event (handle->process (-> self slave s5-6)) 'leave)
                (+! gp-2 1)
                )
              )
            (if (zero? gp-2)
                (go-virtual complete)
                )
            )
          )
        )
      )
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-burning-bush-markb-mercenary-resolution)
  TASK_MANAGER_CODE_HOOK
  (lambda :behavior task-manager
    ()
    (when (or
            ;; Always play voice line on the very first attempt
            (zero? (-> *game-info* sub-task-list (game-task-node city-burning-bush-markb-mercenary-resolution) death-count))
            ;; 10% chance on all subsequent attempts
            (rand-vu-percent? 0.1)
            )
      (suspend-for (seconds 3))
      (case (the int (* (rand-vu) 2.0))
        ;; "Jak: This is payback!"
        ((0) (add-process *gui-control* self (gui-channel daxter) (gui-action play) "jak066" -99.0 0))
        ;; "Daxter: We got company jak, lots of guards!"
        ((1) (add-process *gui-control* self (gui-channel daxter) (gui-action play) "ds152" -99.0 0))
        )
      )
    ;; Constantly check if the results flag is set
    (until (nonzero? (-> self data-int32 5))
      (suspend)
      )
    ;; Now run the results screen
    (merc-show-results)
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-burning-bush-markb-mercenary-resolution)
  TASK_MANAGER_COMPLETE_HOOK
  (lambda :behavior task-manager () (none)) ;; no behavior as task cannot be completed anyway
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-burning-bush-markb-mercenary-resolution)
  TASK_MANAGER_FAIL_HOOK
  (lambda :behavior task-manager ()
    (merc-show-results)
    ;; Ignore current continue on Triangle press after dying  
    (set-continue! *game-info* (-> self info fail-continue) #f)
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-burning-bush-markb-mercenary-resolution)
  TASK_MANAGER_CLEANUP_HOOK
  (lambda :behavior task-manager
    ()
    (set! *merc-tracking-active* #f)
    ;; Kill timer hud 
    (send-event (handle->process (-> self slave 27)) 'hide-and-die)
    ;; Kill points hud
    (send-event (handle->process (-> self slave 28)) 'hide-and-die)
    ;; Kill high-score hud
    (send-event (handle->process (-> self slave 31)) 'hide-and-die)
    ;; Kill combo hud
    (when (handle->process *merc-combo-proc*)
      (deactivate (handle->process *merc-combo-proc*))
      )
    ;; Restore normal traffic settings 
    (let ((a0-0 *traffic-manager*))
      (send-event a0-0 'restore-default-settings)
      )
    
    ;; Remove override so weather system takes over again
    (set! (-> *mood-control* overide-weather-flag) #f)
    ;; Set current weather to heavy rain right now
    (set! (-> *mood-control* current-interp cloud) 1.0)
    (set! (-> *mood-control* current-interp fog) 1.0)
    ;; Set target to heavy rain with a slow transition speed
    ;; so it takes a long time before the random system picks a new target
    (set! (-> *mood-control* target-interp cloud) 1.0)
    (set! (-> *mood-control* target-interp fog) 1.0)
    ;; Reset the random timer to a long delay before next weather change
    (set-time-for-random-weather! *mood-control* 18000.0 18000.0)
    ;;Remove onintent blocking plane
    (let ((plane (process-by-name "blocking-plane-markb-mercenary" *active-pool*)))
      (when plane
        (deactivate plane)
        )
    )
    ;; Remove security walls
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-2" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-3" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-4" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-5" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-6" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-7" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-8" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-9" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-10" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-11" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-12" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-13" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-14" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (let ((wall-proc (process-by-name "security-wall-markb-mercenary-15" *active-pool*)))
      (when wall-proc
        (deactivate wall-proc)
        )
    )
    (none)
    )
  )
