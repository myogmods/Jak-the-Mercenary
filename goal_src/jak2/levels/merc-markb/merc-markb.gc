    (set! (-> self slave 48)
      (ppointer->handle
        (process-spawn security-wall
          (new 'static 'vector :x (meters 538.80) :y (meters  20.56) :z (meters 706.45) :w 1.0)
          (new 'static 'vector :x (meters 538.80) :y (meters  20.56) :z (meters 617.90) :w 1.0)
          (meters 15)
          :init security-wall-init-by-other
          :name "security-wall-markb-mercenary-11"
          )
