(set-subtask-hook!
  *game-info*
  (game-task-node forest-burning-bush-forest-mercenary-resolution)
  TASK_MANAGER_COMPLETE_HOOK
  (lambda :behavior task-manager () (none)) ;; no behavior as task cannot be completed anyway
  )

(set-subtask-hook!
  *game-info*
  (game-task-node forest-burning-bush-forest-mercenary-resolution)
  TASK_MANAGER_FAIL_HOOK
  (lambda :behavior task-manager ()
    (merc-show-results)
    ;; Ignore current continue on Triangle press after dying  
    (set-continue! *game-info* (-> self info fail-continue) #f)
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node forest-burning-bush-forest-mercenary-resolution)
  TASK_MANAGER_CLEANUP_HOOK
  (lambda :behavior task-manager
    ()
    (set! *merc-tracking-active* #f)
    ;; Kill timer hud 
    (send-event (handle->process (-> self slave 27)) 'hide-and-die)
    ;; Kill points hud
    (send-event (handle->process (-> self slave 28)) 'hide-and-die)
    ;; Kill high-score hud
    (send-event (handle->process (-> self slave 31)) 'hide-and-die)
    
    ;; Remove override so weather system takes over again
    (set! (-> *mood-control* overide-weather-flag) #f)
    ;; Set current weather to heavy rain right now
    (set! (-> *mood-control* current-interp cloud) 1.0)
    (set! (-> *mood-control* current-interp fog) 1.0)
    ;; Set target to heavy rain with a slow transition speed
    ;; so it takes a long time before the random system picks a new target
    (set! (-> *mood-control* target-interp cloud) 1.0)
    (set! (-> *mood-control* target-interp fog) 1.0)
    ;; Reset the random timer to a long delay before next weather change
    (set-time-for-random-weather! *mood-control* 18000.0 18000.0)
    
    ;; Remove security wall (add this back later when task is working)
    ;; (let ((wall-proc (process-by-name "security-wall-forest-mercenary" *active-pool*)))
    ;;   (when wall-proc
    ;;     (deactivate wall-proc)
    ;;     )
    ;; )
    (let ((a0-1 (process-by-name "transport-level-1" *active-pool*)))
      (if a0-1
          (send-event a0-1 'leave)
          )
      )
    (let ((a0-3 (process-by-name "transport-level-2" *active-pool*)))
      (if a0-3
          (send-event a0-3 'leave)
          )
      )
    (speech-control-method-9 *speech-control*)
    (none)
    )
  )