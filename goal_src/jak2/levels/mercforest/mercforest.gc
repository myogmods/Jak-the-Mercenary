(defmethod burning-bush-method-32 ((this burning-bush))
  (let* ((gp-1 (vector-! (new 'stack-no-clear 'vector) (target-pos 0) (-> this root trans)))
         (f30-0 (vector-dot (vector-x-quaternion! (new 'stack-no-clear 'vector) (-> this root quat)) gp-1))
         (f0-2 (vector-dot (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> this root quat)) gp-1))
         )
    (and *target*
         (not (focus-test? *target* pilot))
         (< (fabs f30-0) 10240.0)
         (< 0.0 f0-2)
         (< (fabs f0-2) 20480.0)
         )
    )
  )

(defmethod burning-bush-method-30 ((this burning-bush))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((v1-6 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-6 prim-core collide-as) (collide-spec crate))
      (set! (-> v1-6 prim-core collide-with) (collide-spec jak player-list tobot))
      (set! (-> v1-6 prim-core action) (collide-action solid rideable))
      (set! (-> v1-6 transform-index) 3)
      (set-vector! (-> v1-6 local-sphere) 0.0 0.0 0.0 20480.0)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) v1-6)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-9 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-9 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-9 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

(defmethod burning-bush-method-31 ((this burning-bush))
  (set! (-> this part) (create-launch-control group-ctywide-burning-bush-holo-on this))
  (set! (-> this part-off) (create-launch-control group-ctywide-burning-bush-holo-off this))
  (set! (-> this part-alert) (create-launch-control group-ctywide-burning-bush-holo-red this))
  0
  (none)
  )

;; WARN: Return type mismatch process-focusable vs burning-bush.
(defmethod relocate ((this burning-bush) (offset int))
  (if (nonzero? (-> this task))
      (&+! (-> this task) offset)
      )
  (if (nonzero? (-> this part-off))
      (&+! (-> this part-off) offset)
      )
  (if (nonzero? (-> this part-alert))
      (&+! (-> this part-alert) offset)
      )
  (the-as burning-bush ((method-of-type process-focusable relocate) this offset))
  )

(defmethod run-logic? ((this burning-bush))
  "Should this process be run? Checked by execute-process-tree."
  (or (not (logtest? (-> this mask) (process-mask actor-pause)))
      (or (and (nonzero? (-> this draw))
               (logtest? (-> this draw status) (draw-control-status on-screen))
               (>= (+ (-> *ACTOR-bank* pause-dist) (-> this root pause-adjust-distance))
                   (vector-vector-distance (-> this root trans) (math-camera-pos))
                   )
               )
          (and (nonzero? (-> this skel)) (!= (-> this skel root-channel 0) (-> this skel channel)))
          (and (nonzero? (-> this draw)) (logtest? (-> this draw status) (draw-control-status uninited)))
          )
      )
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this burning-bush) (arg0 entity-actor))
  "Typically the method that does the initial setup on the process, potentially using the [[entity-actor]] provided as part of that.
   This commonly includes things such as:
   - stack size
   - collision information
   - loading the skeleton group / bones
   - sounds"
  (burning-bush-method-30 this)
  (process-drawable-from-entity! this arg0)
  ;; (ctywide-entity-hack)
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-burning-bush" (the-as (pointer uint32) #f)))
    (the-as pair 0)
    )
  (burning-bush-method-31 this)
  (let ((f0-0 (res-lump-float (-> this entity) 'rotoffset)))
    (if (!= f0-0 0.0)
        (quaternion-rotate-local-y! (-> this root quat) (-> this root quat) f0-0)
        )
    )
  (set! (-> this task)
        (new 'process 'game-task-control (res-lump-value arg0 'task-actor game-task-actor :time -1000000000.0))
        )
  (set! (-> this angle) 0.0)
  (set! (-> this root pause-adjust-distance) 819200.0)
  (transform-post)
  (go (method-of-object this idle))
  (none)
  )

;;-*-Lisp-*-
(in-package goal)

;; transport-mercenary: transport-level behavior + transport city turret shooting
;; Used for non-city mercenary missions (forest etc.)
;; Spawns crimson-guard-level guards like transport-level
;; Has turret that shoots at Jak like city transport

(deftype transport-mercenary (process-focusable)
  ((y-dest                 float)
   (last-guard-spawn-time  time-frame)
   (nav-mesh               nav-mesh)
   (spawn-side             uint32)
   (spawn?                 symbol)
   (leave-time             time-frame)
   (max-guard              uint32)
   (count-guard            uint32)
   (spawn-time             time-frame)
   (ambient-sound-id       sound-id)
   (num-wanted-guards      uint32)
   (guards                 handle  8)
  ;;  (turret                 handle) ;; add this back later
   )
  (:state-methods
   come-down
   idle
   leave
   die-fast
   )
  (:methods
   (init-collision! (_type_) none)
   (spawn-guard! (_type_) none)
   (update-sound! (_type_) none)
   (set-turret-target! (_type_ process) none)
   )
  )

(defmethod update-sound! ((this transport-mercenary))
  (let ((f30-0 (lerp-scale 0.0 2.0 (fabs (-> this root transv y)) 0.0 122880.0))
        (f0-4 (lerp-scale 0.0 1.0 (- (-> this root trans y) (-> this y-dest)) 143360.0 20480.0))
        (a0-3 (static-sound-spec "transport" :volume 0.0 :mask (pitch reg0)))
        )
    (set! (-> a0-3 volume) (the int (* 1024.0 f0-4)))
    (set! (-> a0-3 pitch-mod) (the int (* 1524.0 f30-0)))
    (sound-play-by-spec a0-3 (-> this ambient-sound-id) (-> this root trans))
    )
  0
  (none)
  )

;; (defmethod set-turret-target! ((this transport-mercenary) (arg0 process))
;;   (let ((v1-1 (handle->process (-> this turret))))
;;     (if v1-1
;;         (set! (-> (the-as vehicle-turret v1-1) target) (process->handle arg0))
;;         )
;;     )
;;   0
;;   (none)
;;   )

(defmethod spawn-guard! ((this transport-mercenary))
  (let ((alive 0))
    (dotimes (i 8)
      (if (handle->process (-> this guards i))
          (+! alive 1)
          )
      )
    (when (and (-> this nav-mesh)  ;; guard against null nav-mesh
               (time-elapsed? (-> this last-guard-spawn-time) (-> this spawn-time))
               (< alive (the-as int (-> this num-wanted-guards)))
               )
      ;; Spawn crimson-guard-level exactly like transport-level does
      (let ((params (new 'stack-no-clear 'crimson-guard-level-params)))
        (set! (-> params transport-side) (-> this spawn-side))
        (set! (-> params nav-mesh) (-> this nav-mesh))
        (set! (-> params pos quad) (-> this root trans quad))
        (+! (-> params pos y) 8192.0)
        (quaternion-rotate-local-y! (-> params quat) (-> this root quat) 32768.0)
        (set! (-> params handle) (the-as uint (process->handle this)))
        (set! (-> params weapon) 1)
        ;; Find empty guard slot and spawn
        (dotimes (i (the-as int (-> this num-wanted-guards)))
          (when (not (handle->process (-> this guards i)))
            (set! (-> this guards i)
                  (ppointer->handle (process-spawn crimson-guard-level params :to this))
                  )
            #t
            (goto cfg-done)
            )
          )
        (label cfg-done)
        (when (-> params proc)
          (set! (-> this spawn-side) (- 1 (the-as int (-> this spawn-side))))
          (set-time! (-> this last-guard-spawn-time))
          (+! (-> this count-guard) 1)
          )
        )
      )
    )
  (none)
  )

(defbehavior transport-mercenary-event-handler transport-mercenary
    ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (case arg2
    (('die-fast)
     (go-virtual die-fast)
     )
    (('leave)
     (if (not (and (-> self next-state)
                   (let ((v1-6 (-> self next-state name)))
                     (or (= v1-6 'leave) (= v1-6 'die-fast))
                     )
                   )
              )
         (go-virtual leave)
         )
     )
    (('guards-left)
     (- (-> self max-guard) (-> self count-guard))
     )
    (('stop-spawning)
     (set! (-> self spawn?) #f)
     #f
     )
    )
  )

(defstate come-down (transport-mercenary)
  :virtual #t
  :event transport-mercenary-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set-time! (-> self last-guard-spawn-time))
    )
  :code (behavior ()
    (ja-channel-push! 1 0)
    (ja-no-eval :group! transport-idle-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (sleep-code)
    )
  :post (behavior ()
    (set! (-> self root transv y) (* 2.0 (- (-> self y-dest) (-> self root trans y))))
    (set! (-> self root transv y) (fmax -122880.0 (fmin 122880.0 (-> self root transv y))))
    (+! (-> self root trans y) (* (-> self root transv y) (seconds-per-frame)))
    (if (< (fabs (- (-> self root trans y) (-> self y-dest))) 409.6)
        (go-virtual idle)
        )
    (update-sound! self)
    (transform-post)
    )
  )

(defstate idle (transport-mercenary)
  :virtual #t
  :event transport-mercenary-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! (-> self root transv y) 0.0)
    (set! (-> self last-guard-spawn-time) 0)
    0
    )
  :exit (behavior ()
    ;; (set-turret-target! self (the-as process #f)) ;; add back later
    )
  :code (behavior ()
    (ja-channel-push! 1 0)
    (sound-play "tran-door-open")
    (ja-no-eval :group! transport-hatch-open-ja :num! (seek! max 0.5) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek! max 0.5))
      )
    (sleep-code)
    )
  :post (behavior ()
    ;; Spawn guards
    (if (-> self spawn?)
        (spawn-guard! self)
        )
    ;; Leave when max guards spawned
    (when (and (zero? (-> self leave-time))
               (nonzero? (-> self max-guard))
               (>= (-> self count-guard) (-> self max-guard))
               )
      (set! (-> self leave-time) (+ (current-time) (seconds 3)))
      (send-event self 'stop-spawning)
      )
    ;; Check leave timer
    (if (and (nonzero? (-> self leave-time)) (< (-> self leave-time) (current-time)))
        (go-virtual leave)
        )
    ;; Point turret at Jak
    ;; (set-turret-target! self *target*) ;; add back later
    (update-sound! self)
    (transform-post)
    )
  )

(defstate leave (transport-mercenary)
  :virtual #t
  :event transport-mercenary-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! (-> self root transv y) 0.0)
    )
  :code (behavior ()
    (ja-channel-push! 1 0)
    (sound-play "tran-thrust")
    (sound-play "tran-door-close")
    (ja-no-eval :group! transport-hatch-close-ja :num! (seek! max 0.2) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek! max 0.2))
      )
    (sleep-code)
    )
  :post (behavior ()
    (update-sound! self)
    (+! (-> self root transv y) (* 40960.0 (seconds-per-frame)))
    (set! (-> self root transv y) (fmax -122880.0 (fmin 122880.0 (-> self root transv y))))
    (+! (-> self root trans y) (* (-> self root transv y) (seconds-per-frame)))
    (if (and (not (logtest? (-> self draw status) (draw-control-status on-screen)))
             (< 163840.0 (- (-> self root trans y) (-> self y-dest)))
             )
        (go-virtual die-fast)
        )
    (transform-post)
    )
  )

(defstate die-fast (transport-mercenary)
  :virtual #t
  :code (behavior ()
    (sound-stop (-> self ambient-sound-id))
    (cleanup-for-death self)
    )
  )

(defmethod init-collision! ((this transport-mercenary))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrated-by) (penetrate))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 2) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 3))
      (set! (-> s4-0 prim-core collide-as) (collide-spec obstacle))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid))
      (set-vector! (-> s4-0 local-sphere) 0.0 20480.0 0.0 69632.0)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (let ((v1-12 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-12 prim-core collide-as) (collide-spec obstacle))
      (set! (-> v1-12 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-12 prim-core action) (collide-action solid))
      (set! (-> v1-12 transform-index) 4)
      (set-vector! (-> v1-12 local-sphere) 0.0 0.0 0.0 40960.0)
      )
    (let ((v1-14 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 1) (the-as uint 0))))
      (set! (-> v1-14 prim-core collide-as) (collide-spec obstacle))
      (set! (-> v1-14 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-14 prim-core action) (collide-action solid))
      (set! (-> v1-14 transform-index) 3)
      (set-vector! (-> v1-14 local-sphere) 0.0 20480.0 0.0 69632.0)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-17 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-17 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-17 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

(defmethod init-from-entity! ((this transport-mercenary) (arg0 entity-actor))
  (init-collision! this)
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name *level* "skel-transport-level" (the-as (pointer uint32) #f)))
    (the-as pair 0)
    )
  (logclear! (-> this mask) (process-mask actor-pause))
  (process-entity-status! this (entity-perm-status no-kill) #t)
  (set! (-> this spawn?) #t)
  (set! (-> this spawn-side) (the-as uint 0))
  (set! (-> this nav-mesh) (nav-mesh-from-res-tag arg0 'nav-mesh-actor 0))
  (set! (-> this num-wanted-guards) (the-as uint 4))
  (set! (-> this max-guard) (the-as uint 8))
  (set! (-> this count-guard) (the-as uint 0))
  (dotimes (i 8)
    (set! (-> this guards i) (the-as handle #f))
    )
  (set! (-> this spawn-time) (seconds 4))
  (set! (-> this leave-time) 0)
  (set! (-> this ambient-sound-id) (new-sound-id))
  ;; Spawn turret as child — same as city transport
  ;; (set! (-> this turret) ;; add back later
  ;;       (ppointer->handle (process-spawn vehicle-turret *transport-turret-control-info* :to this))
  ;;       )
  (+! (-> this root trans y) 40960.0)
  (set! (-> this y-dest) (-> this root trans y))
  (+! (-> this root trans y) 163840.0)
  (go (method-of-object this come-down))
  (none)
  )

(deftype mercforest-transport-info (structure)
  ((id          uint32)
   (spawned     basic)
   (plane-pos   vector      :inline)
   (plane-quat  quaternion  :inline)
   (t-pos       vector      :inline)
   (t-quat      quaternion  :inline)
   (num-guard   uint32)
   )
  )

(define *mercforest-transport-info* (new 'static 'boxed-array :type mercforest-transport-info
                                      (new 'static 'mercforest-transport-info
                                        :id #x1
                                        :plane-pos (new 'static 'vector :x (meters -693.81) :y (meters  36.20) :z (meters 835.40) :w 1.0)
                                        :plane-quat (new 'static 'quaternion :x 0.00 :y 0.72 :z -0.00 :w -0.68)
                                        :t-pos (new 'static 'vector :x (meters -686.72) :y (meters  48.78) :z (meters 836.55) :w 1.0)
                                        :t-quat (new 'static 'quaternion :x -0.00 :y 0.63 :z -0.00 :w 0.77)
                                        :num-guard #x14
                                        )
                                      )
        )

(defbehavior merc-show-rules task-manager ()
  (logior! (-> *game-info* secrets) (game-secrets invulnerable))
  (until (process-grab? *target* #f) (suspend))
  (until (cpad-pressed? 0 confirm)
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf))
                                (bucket-id debug-no-zbuf1)
                                )
                                (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) 
                                                                  (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                                )
      (let ((level-string (cond
                      ((= (level-status *level* 'ctyslumc) 'active)  "(Water Slums)")
                      ((= (level-status *level* 'ctygenc) 'active)   "(Central Plaza)")
                      ((= (level-status *level* 'ctymarkb) 'active)  "(Bazaar)")
                      ((= (level-status *level* 'forest) 'active)    "(Forest)")
                      )
                    )
           )
      ;; Jak the Mercenary line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 75 0.0 (font-color yellow) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.8)
        (pc-encode-utf8-string (string-format "Jak the Mercenary") *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      ;; Level line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 100 0.0 (font-color yellow) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.7)
        (pc-encode-utf8-string (string-format level-string) *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      ;; Destroy as many guards line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 160 0.0 (font-color default) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.4)
        (pc-encode-utf8-string (string-format "Destroy as many guards as you can within the time limit!") *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      ;; Collect clocks line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 200 0.0 (font-color default) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.4)
        (pc-encode-utf8-string (string-format "Collect clock items for extra time!") *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      ;; Go for high score line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 240 0.0 (font-color default) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.4)
        (pc-encode-utf8-string (string-format "Aim for the high-score!") *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 370 0.0 (font-color default) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.6)
        (format (clear *temp-string*) "Press ~S to start!" (lookup-text! *common-text* (text-id pad-x) #f))
        (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      )
    )
    (suspend)
  )
  (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons confirm x))
  (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons confirm x))
  (logclear! (-> *game-info* secrets) (game-secrets invulnerable))
  (until (process-release? *target*) (suspend))
  (play-sound-file "gunshot-2.wav" (the int (* (-> *setting-control* user-current sfx-volume) 30.0)))
)

(defbehavior merc-show-results task-manager ()
  ;; Kill HUDs
  (send-event (handle->process (-> self slave 27)) 'hide-and-die)
  (send-event (handle->process (-> self slave 28)) 'hide-and-die)
  (send-event (handle->process (-> self slave 31)) 'hide-and-die)
  ;; Save highscore
  (game-info-method-28 *game-info* (the-as game-score 8) (-> *game-info* score))
  ;; Despawn all transports (add this back later after figuring out forest transports)
  ;; (dotimes (i (length *mercforest-transport-info*))
  ;;          (when (handle->process (-> self slave i))
  ;;                (send-event (handle->process (-> self slave i)) 'leave)
  ;;          )
  ;; )
  ;; Stop new transports from spawning by setting the flag to 1
  (set! (-> self data-int32 6) 1)
  ;; Make Jak "invisible" to guards 
  (when *target* (logclear! (-> *target* mask) (process-mask target)))
  ;; Compute rank
  (let* ((kills       (the int (-> *game-info* score)))
         (hi-score    (the int (-> (get-game-score-ref *game-info* 8) 0)))
         (rank-string (cond
                        ((>= kills 500) "Renegade")
                        ((>= kills 400) "Our Hero!")
                        ((>= kills 300) "Heir of Mar")
                        ((>= kills 200) "Underground Fighter")
                        ((>= kills 100) "Time Traveller")
                        ((>= kills 50)  "Brave Adventurer")
                        (else           "Villager")
                      )
         )
        )
    ;; Play jingle if this run is a new high score
    (when (>= kills hi-score)
      (play-sound-file "item-obtained.mp3" (the int (* (-> *setting-control* user-current sfx-volume) 200.0)))
      )
    (until (or (cpad-pressed? 0 confirm) (cpad-pressed? 0 triangle))
           (process-grab? *target* #f) ;; Remove control of Jak
           (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf))
                                        (bucket-id debug-no-zbuf1)
                                       )
                                       (dma-buffer-add-gs-set-flusha buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)) 
                                                                         (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                                       )
      ;; RESULT line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 50 0.0 (font-color red) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 1.8)
        (pc-encode-utf8-string (string-format "Results") *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      ;; High Score line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 160 0.0 (font-color default) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.6)
        (pc-encode-utf8-string (string-format "High Score: ~D" hi-score) *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      ;; Total Points line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 210 0.0 (font-color default) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.6)
        (pc-encode-utf8-string (string-format "Total Points: ~D" kills) *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      ;; Rank line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 260 0.0 (font-color default) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.6)
        (pc-encode-utf8-string (string-format "Rank: ~S" rank-string) *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      ;; Retry? line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 340 0.0 (font-color progress-old-yellow) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.7)
        (pc-encode-utf8-string (string-format "Try Again?") *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
      ;; X = Yes, Δ = No line
      (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 270 370 0.0 (font-color progress-old-yellow) (font-flags shadow kerning middle large))))
        (set! (-> font-ctx scale) 0.7)
        (format (clear *temp-string*) "~S = Yes, ~S = No"
                (lookup-text! *common-text* (text-id pad-x) #f)
                (lookup-text! *common-text* (text-id pad-triangle) #f))
        (pc-encode-utf8-string *temp-string* *pc-encoded-temp-string*)
        (draw-string-adv *pc-encoded-temp-string* buf font-ctx)
        )
  )
    (suspend)
    )
    ;; Capture button press BEFORE releasing control
  (let ((pressed-confirm (cpad-pressed? 0 confirm)))
  ;; Clear the X button press so Jak doesn't jump when control is restored
  (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons confirm x))
  (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons confirm x))
  ;; Release control back to Jak
  (until (process-release? *target*)
    (suspend)
    )
  
  (if pressed-confirm
      ;; X — retry mission
      (let ((a1-0 (new 'stack-no-clear 'fail-mission-params)))
        (set! (-> a1-0 flags) (fail-mission-flags famflags-0 famflags-2))
        (set! (-> a1-0 message) (fail-mission-message fammsg-1))
        (set! (-> a1-0 retry-continue) (-> self info retry-continue))
        (set! (-> a1-0 fail-continue) (-> self info retry-continue))
        (set! (-> a1-0 reset-delay) (the-as uint 0))
        (set! (-> a1-0 task) (-> self node-info task))
        (set! (-> a1-0 fail-message) (text-id null))
        (logior! (-> a1-0 flags) (fail-mission-flags famflags-3 famflags-4 famflags-5 famflags-6))
        (start! *fail-mission-control* a1-0)
        (while (handle->process (-> *fail-mission-control* process))
          (suspend)
          )
        )
      ;; Triangle - close task node and reopen it, ending task on the spot 
      (and (task-node-close! (game-task-node forest-burning-bush-forest-mercenary-resolution))
           (task-node-open! (game-task-node forest-burning-bush-forest-mercenary-introduction))
      )
      )
    )
  )
  (none)
)

